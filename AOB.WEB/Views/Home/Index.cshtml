@model AOB.WEB.ViewModels.Home.DashboardViewModel
@using AOB.BAL.Common.Constants
@using AOB.BAL.Common.Enums
@using AOB.BAL.Common.Helpers
@using AOB.WEB.ViewModels.Home
@using AOB.WEB.Helpers
@{
    ViewData["Title"] = "Home";

    var data = Model.Data;


    var customerSegments = data.CustomerSegments;

    // Four cards. "Completed" counts every project the customer has finished and sent in (submitted, being
    // provisioned, account being created, or completed); the rest of the pipeline is not shown separately.
    var projectKpiCards = new (string Label, string Hint, string Tone, ProjectStatus[] Statuses)[]
    {
        ("Completed", "Submitted and completed", "tone-green-bright",
            new[] { ProjectStatus.Completed, ProjectStatus.Submitted, ProjectStatus.Provisioning, ProjectStatus.AccountCreation }),
        ("Pending approval", "Awaiting approval", "tone-amber", new[] { ProjectStatus.Approval }),
        ("Draft", "Completed setup, saved as draft", "tone-navy", new[] { ProjectStatus.Draft }),
        ("In progress", "Setup screens in progress", "tone-purple", new[] { ProjectStatus.InProgress })
    };

    int ProjectCount(ProjectStatus status)
        => data.ProjectCountsByStatus.TryGetValue(status, out var n) ? n : 0;

    string subtitle = Model.Audience switch
    {
        DashboardAudience.Internal => "Overview of all customers and onboarding projects across PCI Pal.",
        DashboardAudience.Partner => "Your customers and their onboarding projects at a glance.",
        _ => "Your onboarding status and projects."
    };

    var greetName = User.Identity?.Name?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";
    var greetTime = DateTime.Now.Hour < 12 ? "Good morning" : DateTime.Now.Hour < 18 ? "Good afternoon" : "Good evening";
    ViewData["FullBleed"] = true;
    if (Model.Audience == DashboardAudience.Customer)
    {
        if (!string.IsNullOrWhiteSpace(Model.CompanyName))
        {
            ViewData["UserCompanyName"] = Model.CompanyName;
        }
    }

    var homeProjects = Model.Audience == DashboardAudience.Customer
        ? Model.CustomerProjects.OrderByDescending(p => p.CreatedAt).Take(5).ToList()
        : [];
    var thingsNeedYou = Model.Audience == DashboardAudience.Customer
        ? CustomerHomeQueue.ThingsNeedingYou(Model.Queue)
        : 0;
}

@if (Model.Audience == DashboardAudience.Customer)
{
    <section class="band home-band">
        <div class="wrap rise">
            <div class="eyebrow">@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "PCI Pal onboarding" : Model.CompanyName)</div>
            <h1 class="h1" style="margin-top:8px">@greetTime, @greetName</h1>
            <p class="lede" style="margin-top:6px">
                @if (data.TotalProjects == 0)
                {
                    @:You have no projects yet. Start one whenever you're ready, and complete your company profile alongside it.
                }
                else
                {
                    var withPci = Model.CustomerProjects.Count(p =>
                    {
                        var k = ProjectOnboardingPresentation.Court(p.Status, p.CurrentStep, p.InformationRequestStatus, p.AwaitingUsersCsv).Kind;
                        return k is "pp" or "sys";
                    });
                    @($"{(thingsNeedYou > 0 ? $"{thingsNeedYou} {(thingsNeedYou == 1 ? "thing needs" : "things need")} you. " : "Nothing needs you right now. ")}{(withPci > 0 ? $"{withPci} {(withPci == 1 ? "project is" : "projects are")} with PCI Pal." : "")}")
                }
            </p>
            @if (data.TotalProjects > 0)
            {
                var withPci = Model.CustomerProjects.Count(p =>
                {
                    var k = ProjectOnboardingPresentation.Court(p.Status, p.CurrentStep, p.InformationRequestStatus, p.AwaitingUsersCsv).Kind;
                    return k is "pp" or "sys";
                });
                var live = ProjectCount(ProjectStatus.Completed);
                var prep = ProjectCount(ProjectStatus.InProgress) + ProjectCount(ProjectStatus.Draft);
                <div class="home-sum" aria-label="Summary">
                    <div class="k"><span class="kv">@prep</span><span class="kl">Being prepared</span></div>
                    <div class="k"><span class="kv">@withPci</span><span class="kl">With PCI Pal</span></div>
                    <div class="k"><span class="kv">@live</span><span class="kl">Live in staging</span></div>
                    <div class="k"><span class="kv">@Model.ReadinessReady/@(Model.ReadinessTotal > 0 ? Model.ReadinessTotal : 1)</span><span class="kl">Account readiness</span></div>
                </div>
            }
        </div>
    </section>
    <div class="wrap overlap rise">
        <section class="sheet queue" aria-labelledby="home-next-h">
            <div class="sheet-h">
                <div style="flex:1">
                    <h2 class="h3" id="home-next-h">Your next steps</h2>
                    <p class="small muted">Things only you can do, most urgent first</p>
                </div>
                <a asp-controller="Projects" asp-action="Create" asp-route-returnUrl="@NavigationReturnUrl.Current(Context.Request)" class="btn btn-primary btn-sm">
                    <svg class="i sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    New project
                </a>
            </div>
            @if (Model.Queue.Count > 0)
            {
                <div class="ledger">
                    @foreach (var item in Model.Queue)
                    {
                        var p = item.Project;
                        <div class="lrow">
                            <span class="qic @item.Tone" aria-hidden="true">
                                @switch (item.Icon)
                                {
                                    case "message":
                                        <svg class="i sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                                        break;
                                    case "edit":
                                        <svg class="i sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                                        break;
                                    case "send":
                                        <svg class="i sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z" /></svg>
                                        break;
                                    default:
                                        <svg class="i sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4l14 8-14 8z" /></svg>
                                        break;
                                }
                            </span>
                            <div style="min-width:0">
                                <div class="t">@item.Title</div>
                                <div class="d">@p.Name · @item.Detail</div>
                            </div>
                            <span class="jmcell hide-sm">
                                <partial name="Onboarding/_JourneyMeter" model="@(p.Status, p.CurrentStep, p.InformationRequestStatus, p.CreatedAt, true, (BuildType?)null, p.RequiresAccount, p.AwaitingUsersCsv)" />
                            </span>
                            @if (CustomerHomeQueue.IsReadyToSubmit(p))
                            {
                                <a asp-controller="Projects" asp-action="Readiness" asp-route-id="@p.Id" class="btn btn-sm qa btn-primary">
                                    Readiness check
                                    <svg class="i xs" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Projects" asp-action="@item.ActionName" asp-route-id="@p.Id"
                                   class="btn btn-sm qa @(item.Tone == "ok" ? "btn-quiet" : "btn-primary")">
                                    @item.ActionLabel
                                    <svg class="i xs" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
            else if (data.TotalProjects == 0)
            {
                <div class="empty sheet-b">
                    <div class="art" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
                    <h3 class="h3">Start your first onboarding project</h3>
                    <p class="muted" style="max-width:56ch">A project covers one PCI Pal service rollout. Expect about 20 minutes of questions across four sections. You can save and come back at any time.</p>
                </div>
            }
            else
            {
                <div class="empty sheet-b">
                    <h3 class="h3">You're all caught up</h3>
                    <p class="muted">PCI Pal or the system has the next step on every project. We'll email you when something needs you.</p>
                </div>
            }
        </section>
    </div>
    <div class="wrap home-grid">
        <section class="sheet" aria-labelledby="home-proj-h">
            <div class="sheet-h">
                <div style="flex:1">
                    <h2 class="h3" id="home-proj-h">Projects</h2>
                    <p class="small muted">Where each rollout stands</p>
                </div>
                @if (data.TotalProjects > 0)
                {
                    <a asp-controller="Projects" asp-action="Index" class="link small">
                        All projects
                        <svg class="i xs" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                    </a>
                }
            </div>
            @if (homeProjects.Count == 0)
            {
                <div class="sheet-b"><p class="muted">Projects you create appear here with a journey meter showing their stage.</p></div>
            }
            else
            {
                <div class="ledger">
                    @foreach (var p in homeProjects)
                    {
                        var dest = p.DeletionScheduledFor is null ? "Details" : "PendingDeletion";
                        <a class="lrow proj-row" asp-controller="Projects" asp-action="@dest" asp-route-id="@p.Id">
                            <span style="min-width:0">
                                <span class="t" style="display:block">@p.Name</span>
                                <span class="ref">@ProjectOnboardingPresentation.ShortReference(p.Id)</span>
                            </span>
                            <span class="jmcell">
                                <partial name="Onboarding/_JourneyMeter" model="@(p.Status, p.CurrentStep, p.InformationRequestStatus, p.CreatedAt, true, (BuildType?)null, p.RequiresAccount, p.AwaitingUsersCsv)" />
                            </span>
                            <span class="courtcell">
                                <partial name="Onboarding/_CourtBadge" model="@(p.Status, p.CurrentStep, p.InformationRequestStatus, p.AwaitingUsersCsv)" />
                            </span>
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                        </a>
                    }
                </div>
            }
        </section>
        <aside class="stack" style="gap:20px">
            <section class="sheet readiness" aria-labelledby="home-ready-h">
                <div class="sheet-h">
                    <div style="flex:1">
                        <h2 class="h3" id="home-ready-h">Account readiness</h2>
                        <p class="small muted">@Model.ReadinessReady of @Model.ReadinessTotal ready · helps PCI Pal review faster</p>
                    </div>
                </div>
                <div class="sheet-b">
                    @foreach (var row in Model.ReadinessSections)
                    {
                        <div class="ri">
                            <span class="tick @(row.Complete ? "on" : "")">
                                @if (row.Complete)
                                {
                                    <svg class="i xs" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                                }
                            </span>
                            <span style="flex:1">@row.Label</span>
                            @if (!row.Complete)
                            {
                                <a asp-controller="CustomerProfile" asp-action="Index" class="link small">Add</a>
                            }
                        </div>
                    }
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="ri">
                            <span class="tick @(doc.IsUploaded ? "on" : "")">
                                @if (doc.IsUploaded)
                                {
                                    <svg class="i xs" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                                }
                            </span>
                            <span style="flex:1">@doc.Name</span>
                            @if (!doc.IsUploaded)
                            {
                                <a asp-controller="CustomerDocuments" asp-action="Index" class="link small">Upload</a>
                            }
                        </div>
                    }
                    <p class="xsmall muted" style="margin-top:10px">Missing documents don’t stop you submitting a project.</p>
                </div>
            </section>
        </aside>
    </div>
    <section class="wrap home-phases rise" aria-labelledby="home-phases-h">
        <h2 class="eyebrow" id="home-phases-h">How onboarding works</h2>
        <div class="phase-strip">
            <div>
                <div class="pb" style="background:var(--blue)"></div>
                <div class="pn">01</div>
                <div class="pt">Prepare</div>
                <p class="pd">You answer four sections of setup questions.</p>
            </div>
            <div>
                <div class="pb" style="background:var(--blue-700)"></div>
                <div class="pn">02</div>
                <div class="pt">Submit</div>
                <p class="pd">Your answers lock. Changes go through support.</p>
            </div>
            <div>
                <div class="pb" style="background:var(--pp)"></div>
                <div class="pn">03</div>
                <div class="pt">Review</div>
                <p class="pd">Standard setups pass straight through. Others get a PCI Pal specialist review.</p>
            </div>
            <div>
                <div class="pb" style="background:var(--sys)"></div>
                <div class="pn">04</div>
                <div class="pt">Provision</div>
                <p class="pd">The system builds your tenant and payment flow.</p>
            </div>
            <div>
                <div class="pb" style="background:var(--ok)"></div>
                <div class="pn">05</div>
                <div class="pt">Live</div>
                <p class="pd">Test in staging with your Setup Document Pack.</p>
            </div>
        </div>
    </section>
}
else
{
    @* Partners and PCI Pal staff: the same band, summary figures and overlapping sheets as the customer home. *@
    var completedCount = projectKpiCards[0].Statuses.Sum(ProjectCount);
    <section class="band home-band">
        <div class="wrap rise">
            <div class="eyebrow">@(Model.Audience == DashboardAudience.Internal ? "PCI Pal staff" : "Partner")</div>
            <div class="row wrap" style="align-items:flex-end;gap:16px;margin-top:8px">
                <div style="flex:1;min-width:260px">
                    <h1 class="h1">@greetTime, @greetName</h1>
                    <p class="lede" style="margin-top:6px">@subtitle</p>
                </div>
                @if (User.IsInRole(nameof(UserType.Partner)))
                {
                    <a asp-controller="Customers" asp-action="Create" class="btn btn-primary">
                        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                        Add customer
                    </a>
                }
            </div>
            <div class="home-sum" aria-label="Summary">
                <div class="k"><span class="kv">@customerSegments.TotalCustomers</span><span class="kl">Customers</span></div>
                <div class="k"><span class="kv">@data.TotalProjects</span><span class="kl">Projects</span></div>
                <div class="k"><span class="kv">@ProjectCount(ProjectStatus.Approval)</span><span class="kl">Pending approval</span></div>
                <div class="k"><span class="kv">@completedCount</span><span class="kl">Submitted and completed</span></div>
            </div>
             @if (Model.Audience == DashboardAudience.Internal && (data.InformationSubmitted > 0 || data.InformationRequested > 0))
        {
            <div class="stack-sm" style="margin-top:20px">
                @if (data.InformationSubmitted > 0)
                {
                    <div class="note you" role="status">
                        <span class="ni" aria-hidden="true"><svg class="i sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /><path d="M12 9v4M12 17h.01" /></svg></span>
                        <div><div class="nd"><strong>@data.InformationSubmitted</strong> @(data.InformationSubmitted == 1 ? "project has" : "projects have") information from the customer waiting for your review.</div></div>
                    </div>
                }
                @if (data.InformationRequested > 0)
                {
                    <div class="note" role="status">
                        <span class="ni" aria-hidden="true"><svg class="i sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" /></svg></span>
                        <div><div class="nd"><strong>@data.InformationRequested</strong> @(data.InformationRequested == 1 ? "project is" : "projects are") waiting for the customer to provide the information you asked for.</div></div>
                    </div>
                }
            </div>
        }
        else if (Model.Audience != DashboardAudience.Internal && data.InformationRequested > 0)
        {
            <div class="note bad" role="alert" style="margin-top:20px">
                <span class="ni" aria-hidden="true"><svg class="i sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg></span>
                <div><div class="nt">Action required</div><div class="nd">We need additional information on @data.InformationRequested @(data.InformationRequested == 1 ? "project" : "projects") to continue.</div></div>
            </div>
        }
        </div>
    </section>

    <div class="wrap overlap rise">
        @* Information requests: staff have something to review, or the customer has something to provide. *@
       

        <div class="home-grid" style="padding-top:0">
            <section class="sheet dash-recent" aria-labelledby="dash-projects-heading" style="overflow:hidden">
                <div class="sheet-h">
                    <div class="sheet-ttl">
                        <h2 class="h3" id="dash-projects-heading">Recent projects</h2>
                        <p class="small muted">
                            @if (data.RecentProjects.Count == 0)
                            {
                                @:No projects yet
                            }
                            else
                            {
                                @:Latest @data.RecentProjects.Count of @data.TotalProjects
                            }
                        </p>
                    </div>
                    <a asp-controller="Projects" asp-action="Index" class="link small">All projects</a>
                </div>

                @if (data.RecentProjects.Count == 0)
                {
                    <div class="empty">
                        <div class="art" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
                        <h3 class="h3">No projects yet</h3>
                        <p>Projects will appear here as customers create them.</p>
                    </div>
                }
                else
                {
                    @* Same rows as the customer home: project, journey meter, who has the next step, chevron. Staff read the badge about the customer. *@
                    var forStaff = Model.Audience == DashboardAudience.Internal;
                    var courtViewData = new ViewDataDictionary(ViewData) { ["ReadOnlyStaff"] = forStaff };
                    <div class="ledger">
                        @foreach (var p in data.RecentProjects)
                        {
                            @* Partners and staff reach every project through its customer. *@
                            <a class="lrow proj-row" asp-controller="Projects" asp-action="@(p.DeletionScheduledFor is null ? "Details" : "PendingDeletion")" asp-route-customerId="@p.CustomerId" asp-route-id="@p.Id">
                                <span style="min-width:0">
                                    <span class="t" style="display:block">@p.Name</span>
                                    <span class="ref">@ProjectOnboardingPresentation.ShortReference(p.Id) · @(string.IsNullOrWhiteSpace(p.CustomerName) ? "Unnamed customer" : p.CustomerName)</span>
                                </span>
                                <span class="jmcell">
                                    <partial name="Onboarding/_JourneyMeter" model="@(p.Status, p.CurrentStep, p.InformationRequestStatus, p.CreatedAt, true, (BuildType?)null, p.RequiresAccount, p.AwaitingUsersCsv)" />
                                </span>
                                <span class="courtcell">
                                    @if (p.DeletionScheduledFor is not null)
                                    {
                                        <span class="court bad"><span class="who">Deleting</span>Scheduled for deletion</span>
                                    }
                                    else
                                    {
                                        <partial name="Onboarding/_CourtBadge" model="@(p.Status, p.CurrentStep, p.InformationRequestStatus, p.AwaitingUsersCsv)" view-data="courtViewData" />
                                        @if (forStaff && p.InformationRequestStatus == InformationRequestStatus.Submitted)
                                        {
                                            <span class="tag you" style="margin-left:6px">Information to review</span>
                                        }
                                    }
                                </span>
                                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                            </a>
                        }
                    </div>
                }
            </section>

            <div class="stack">
                <section class="sheet" aria-labelledby="dash-customers-heading">
                    <div class="sheet-h">
                        <div class="sheet-ttl">
                            <h2 class="h3" id="dash-customers-heading">Customers</h2>
                            <p class="small muted">By project activity</p>
                        </div>
                        <a asp-controller="Customers" asp-action="Index" class="link small">View all</a>
                    </div>
                    <div class="sheet-b">
                        <dl class="facts">
                            <div><dt>Total customers</dt><dd class="num">@customerSegments.TotalCustomers</dd></div>
                            <div><dt>No project started yet</dt><dd class="num">@customerSegments.WithNoProjects</dd></div>
                            <div><dt>A project sent for approval</dt><dd class="num">@customerSegments.WithApprovals</dd></div>
                        </dl>
                    </div>
                </section>

                <section class="sheet" aria-labelledby="dash-states-heading">
                    <div class="sheet-h">
                        <div class="sheet-ttl">
                            <h2 class="h3" id="dash-states-heading">Projects by state</h2>
                            <p class="small muted">@data.TotalProjects total</p>
                        </div>
                    </div>
                    <div class="sheet-b">
                        <dl class="facts">
                            @foreach (var card in projectKpiCards)
                            {
                                <div><dt>@card.Label <span class="small muted">· @card.Hint</span></dt><dd class="num">@card.Statuses.Sum(ProjectCount)</dd></div>
                            }
                        </dl>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
