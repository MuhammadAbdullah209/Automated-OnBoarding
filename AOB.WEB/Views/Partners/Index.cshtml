@model IReadOnlyList<AOB.BAL.DTOs.Partners.PartnerSummaryDto>
@using AOB.BAL.Common.Constants
@{
    ViewData["Title"] = "Partners";
    ViewData["Crumbs"] = "Partners";
    ViewData["FullBleed"] = true;

    var search = ViewData["PartnerSearch"] as string;
    var view = ViewData["PartnerView"] as string ?? "all";
    var counts = ViewData["PartnerCounts"] as IReadOnlyDictionary<string, int> ?? new Dictionary<string, int>();
    var hasFilter = !string.IsNullOrWhiteSpace(search) || view != "all";
    var canManage = User.IsInRole(AppRoles.InternalUser);

    var tabs = new (string Key, string Label)[] { ("all", "All"), ("active", "Active"), ("inactive", "Inactive") };
    Dictionary<string, string?> TabRoute(string key) => new()
    {
        ["view"] = key == "all" ? null : key,
        ["q"] = search
    };
}

<div class="wrap rise projects-band">
    <div class="projects-ph">
        <div class="ttl">
            <div class="eyebrow">PCI Pal staff</div>
            <h1 class="h1">Partners</h1>
            <p class="lede">Partner organisations that onboard and manage their customers.</p>
        </div>
        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-primary">
                <svg class="i sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                Add partner
            </a>
        }
    </div>
    <div class="views" role="tablist" aria-label="Partner views">
        @foreach (var (key, label) in tabs)
        {
            <a role="tab" asp-action="Index" asp-all-route-data="@TabRoute(key)" aria-selected="@(view == key ? "true" : "false")">
                @label
                <span class="c">@counts.GetValueOrDefault(key)</span>
            </a>
        }
    </div>
</div>

<div class="wrap rise projects-page">
    <partial name="_FlashMessages" />

    @if (counts.GetValueOrDefault("all") > 0)
    {
        <form asp-action="Index" method="get" class="filters filters--list1" role="search">
            @if (view != "all")
            {
                <input type="hidden" name="view" value="@view" />
            }
            <div class="field search-f">
                <label class="label" for="partner-search">Search</label>
                <div class="search">
                    <svg class="i sm" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M16 16l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                    <input id="partner-search" class="input tinput" type="search" name="q" value="@search" placeholder="Partner name or email" autocomplete="off" />
                </div>
            </div>
            <div class="filters-clear">
                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-text">Clear filters</a>
                }
            </div>
        </form>
    }

    <section class="sheet projects-sheet" style="overflow:hidden">
        @if (Model.Count == 0)
        {
            <div class="empty">
                <div class="art" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
                @if (hasFilter)
                {
                    <h3 class="h3">No partners match</h3>
                    <p class="muted">Try another tab, change the search, or clear the filters.</p>
                    <a asp-action="Index" class="btn btn-quiet btn-sm">Clear filters</a>
                }
                else
                {
                    <h2 class="h2">No partners yet</h2>
                    <p class="muted">Partners you add will appear here.</p>
                    @if (canManage)
                    {
                        <a asp-action="Create" class="btn btn-primary btn-sm">Add partner</a>
                    }
                }
            </div>
        }
        else
        {
            <div class="ptable-wrap">
                <table class="ptable projects-table">
                    <thead>
                        <tr>
                            <th scope="col">Partner</th>
                            <th scope="col">Sign-in email</th>
                            <th scope="col">Status</th>
                            <th scope="col">Customers</th>
                            <th scope="col">Created</th>
                            <th scope="col"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr onclick="window.location='@Url.Action("Details", new { id = p.Id })'">
                                <td>
                                    <div class="strong">@p.Name</div>
                                    @if (p.Id == PartnerConstants.PcipalPartnerId)
                                    {
                                        <div class="xsmall muted">Default partner · owns direct customers</div>
                                    }
                                </td>
                                <td class="small">@p.Email</td>
                                <td><span class="tag @(p.IsActive ? "ok" : "")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="num small">
                                    <a asp-controller="Customers" asp-action="Index" asp-route-partnerId="@p.Id" class="link" onclick="event.stopPropagation()">@p.CustomerCount @(p.CustomerCount == 1 ? "customer" : "customers")</a>
                                </td>
                                <td class="num small" style="white-space:nowrap">@p.CreatedAt.ToString("d MMM yyyy")</td>
                                <td style="text-align:right" onclick="event.stopPropagation()">
                                    <div class="row-actions">
                                        @if (canManage)
                                        {
                                            <partial name="_PartnerActiveToggle" model="p" view-data='new ViewDataDictionary(ViewData) { ["Variant"] = "switch" }' />
                                        }
                                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-quiet">Open</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pcards ledger">
                @foreach (var p in Model)
                {
                    <a class="lrow proj-row" asp-action="Details" asp-route-id="@p.Id">
                        <span style="min-width:0">
                            <span class="t" style="display:block">@p.Name</span>
                            <span class="ref">@p.Email · @p.CustomerCount @(p.CustomerCount == 1 ? "customer" : "customers")</span>
                        </span>
                        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                        <span class="courtcell" style="grid-column:1/-1">
                            <span class="tag @(p.IsActive ? "ok" : "")">@(p.IsActive ? "Active" : "Inactive")</span>
                        </span>
                    </a>
                }
            </div>

            <div class="sheet-f">
                <span class="small muted">Showing @Model.Count of @counts.GetValueOrDefault("all") @(counts.GetValueOrDefault("all") == 1 ? "partner" : "partners")</span>
            </div>
        }
    </section>
</div>
