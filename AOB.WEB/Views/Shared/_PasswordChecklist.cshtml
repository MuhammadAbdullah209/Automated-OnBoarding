@using AOB.WEB.Validation
@model string
<div class="pw-rules-wrap">
    <div class="meter4" id="@(Model)-meter" aria-hidden="true">
        @for (var i = 0; i < 5; i++)
        {
            <i></i>
        }
    </div>
    <ul class="rules pw-checklist" id="@(Model)-rules" data-password-checklist data-for="@Model"
        data-min="@PasswordPolicyAttribute.MinLength" data-max="@PasswordPolicyAttribute.MaxLength">
        @foreach (var rule in PasswordPolicyAttribute.Rules)
        {
            <li class="rule-i" data-rule="@rule.Key">
                <span class="dot pw-dot" aria-hidden="true">
                    <svg viewBox="0 0 12 10" width="10" height="8" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 5l3 3 7-7" /></svg>
                </span>
                <span>@rule.Label</span>
                <span class="sr-only" data-rule-state>not met</span>
            </li>
        }
    </ul>
</div>
