@* Static example from PCI-Pal onboarding prototype (sign-in landing). *@
<div class="lp-proj" role="img" aria-label="Example project list: each project shows who has the next step and how far along the five stages it is">
    <header>
        <strong>Your projects</strong>
        <span class="lp-tag">Example</span>
    </header>
    <div class="lp-row">
        <div class="lp-top">
            <span class="lp-name">Customer service payments — UK</span>
            <span class="court ok"><span class="who">Live</span>Live in staging</span>
        </div>
        <div class="lp-bars" aria-hidden="true">
            <i style="--d:0"></i><i style="--d:1"></i><i style="--d:2"></i><i style="--d:3"></i><i style="--d:4;--c:var(--ok)"></i>
        </div>
    </div>
    <div class="lp-row">
        <div class="lp-top">
            <span class="lp-name">Collections line — North America</span>
            <span class="court pp"><span class="who">PCI Pal</span>Reviewing</span>
        </div>
        <div class="lp-bars" aria-hidden="true">
            <i style="--d:2"></i><i style="--d:3"></i><i style="--d:4;--c:var(--pp)" class="lp-now"></i><i class="off"></i><i class="off"></i>
        </div>
    </div>
    <div class="lp-row last">
        <div class="lp-top">
            <span class="lp-name">Renewals phone line</span>
            <span class="court you"><span class="who">You</span>Answer 2 questions</span>
        </div>
        <div class="lp-bars" aria-hidden="true">
            <i style="--d:4"></i><i style="--d:5"></i><i style="--d:6;--c:var(--you)" class="lp-now"></i><i class="off"></i><i class="off"></i>
        </div>
    </div>
    <div class="lp-stages" aria-hidden="true">
        <span>Prepare</span><span>Submit</span><span>Review</span><span>Provision</span><span>Live</span>
    </div>
</div>
