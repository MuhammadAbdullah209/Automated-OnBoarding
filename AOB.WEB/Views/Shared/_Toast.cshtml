@model (string Kind, string? Title, string Text)
@* One toast. Kind: ok, bad or info. Wrapped by _FlashMessages or any view that has a one-off confirmation. *@
<div class="toast-item toast-@Model.Kind" data-toast data-kind="@Model.Kind" role="@(Model.Kind == "bad" ? "alert" : "status")">
    <span class="toast-ic" aria-hidden="true">
        @if (Model.Kind == "ok")
        {
            <svg class="i sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5" /></svg>
        }
        else if (Model.Kind == "bad")
        {
            <svg class="i sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 8v4M12 16h.01" /><circle cx="12" cy="12" r="9" /></svg>
        }
        else
        {
            <svg class="i sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="9" /><path d="M12 16v-4M12 8h.01" /></svg>
        }
    </span>
    <div class="toast-body">
        @if (!string.IsNullOrWhiteSpace(Model.Title))
        {
            <div class="toast-t">@Model.Title</div>
        }
        <div class="toast-d">@Model.Text</div>
    </div>
    <button type="button" class="toast-x" data-toast-close aria-label="Dismiss message">
        <svg class="i xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
</div>
