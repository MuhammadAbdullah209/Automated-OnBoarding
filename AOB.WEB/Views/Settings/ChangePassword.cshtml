@model AOB.WEB.ViewModels.Settings.ChangePasswordViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Settings";
    var accountName = User.Identity?.Name ?? "—";
    var accountEmail = User.FindFirstValue(ClaimTypes.Email);
}

<div class="narrow-page rise">
    <div class="ph">
        <div class="ttl">
            <h1 class="h1">Settings</h1>
            <p class="lede" style="margin-top:4px">Your sign-in details and account security.</p>
        </div>
    </div>

    <div class="page-stack">
        <partial name="_FlashMessages" />

        <section class="sheet">
            <div class="sheet-h"><h2 class="h3">Account</h2></div>
            <div class="sheet-b">
                <dl class="dl">
                    <dt>Name</dt><dd>@accountName</dd>
                    @if (!string.IsNullOrWhiteSpace(accountEmail) && !string.Equals(accountEmail, accountName, StringComparison.OrdinalIgnoreCase))
                    {
                        <dt>Sign-in email</dt>
                        <dd>@accountEmail <span class="small muted">· contact support to change</span></dd>
                    }
                </dl>
            </div>
        </section>

        <form asp-controller="Settings" asp-action="ChangePassword" method="post" autocomplete="off" class="sheet sheet-form" novalidate>
            @Html.AntiForgeryToken()
            <div class="sheet-h">
                <div class="sheet-ttl">
                    <h2 class="h3">Change password</h2>
                    <p class="small muted">You stay signed in on this device.</p>
                </div>
            </div>
            <div class="sheet-b" style="max-width:520px">
                <div asp-validation-summary="ModelOnly" class="form-errors errsum" role="alert"></div>

                <div class="field">
                    <label asp-for="CurrentPassword" class="field-label req"></label>
                    <input asp-for="CurrentPassword" class="tinput" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword"></span>
                </div>
                <div class="field">
                    <label asp-for="NewPassword" class="field-label req"></label>
                    <input asp-for="NewPassword" class="tinput" autocomplete="new-password" aria-describedby="NewPassword-rules" />
                    <span asp-validation-for="NewPassword"></span>
                    <partial name="_PasswordChecklist" model="@Html.IdFor(m => m.NewPassword)" />
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword" class="field-label req"></label>
                    <input asp-for="ConfirmPassword" class="tinput" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                    <div class="pw-match" data-password-match data-for="@Html.IdFor(m => m.ConfirmPassword)" data-compare="@Html.IdFor(m => m.NewPassword)" aria-live="polite"></div>
                </div>
            </div>
            <div class="sheet-f">
                <span class="spacer"></span>
                <button type="submit" class="btn btn-primary">Update password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-policy.js" asp-append-version="true"></script>
}
