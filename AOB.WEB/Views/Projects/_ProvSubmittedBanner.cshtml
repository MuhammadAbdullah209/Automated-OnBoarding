@* Shown once, right after the customer submits: a toast in the shared stack, not a banner above the project. *@
<div class="toasts" data-toast-host aria-live="polite">
    <partial name="~/Views/Shared/_Toast.cshtml" model="@(("ok", (string?)"Submitted", "We’ve emailed a confirmation. Your answers are now read-only."))" />
</div>
