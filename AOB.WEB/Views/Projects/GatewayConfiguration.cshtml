@model AOB.BAL.DTOs.Projects.ProjectGatewayConfigurationDto
@using AOB.BAL.Common.Constants
@using AOB.BAL.Common.Enums
@using AOB.BAL.DTOs.Projects
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "~/Views/Projects/_ProjectFlowLayout.cshtml";
    ViewData["Title"] = "Adaptive Configuration";
    var project = (AOB.BAL.DTOs.Projects.ProjectOverviewDto)ViewData["Project"]!;
    ViewData["FlowSubtitle"] = $"Adaptive configuration · {ProjectOptions.ProjectStatusLabels[project.Status]}";
    ViewData["DocSectionNo"] = "04";
    ViewData["DocTitle"] = "Adaptive configuration";
    ViewData["DocLede"] = "The data fields your gateway uses and how payment results return to your system.";
    ViewData["FlowBackAction"] = "PaymentConfiguration";
    ViewData["FlowBackLabel"] = "Payment configuration";
    ViewData["FlowContinueLabel"] = "Save and check readiness";

    var gateway = (GatewayFieldOptionsDto)ViewData["GatewayFields"]!;
    var authentication = gateway.Fields.Where(f => f.FieldType == GatewayFieldType.Authentication).ToList();
    var inputs = gateway.Fields.Where(f => f.FieldType != GatewayFieldType.Authentication && f.IsInput).ToList();
    var outputs = gateway.Fields.Where(f => f.FieldType != GatewayFieldType.Authentication && !f.IsInput).ToList();
    var embeddedInCrm = project.PaymentExperience == CrmPaymentExperience.EmbeddedIframe;
    var postTransactionLabels = ProjectOptions.PostTransactionMethodLabelsFor(project.PaymentExperience);
    var postTransactionSelected = Model.PostTransactionMethods
        .Where(m => postTransactionLabels.ContainsKey(m))
        .ToList();
    var usesCallback = postTransactionSelected.Contains(PostTransactionMethod.WebCallback);
    var usesRedirect = !embeddedInCrm && postTransactionSelected.Contains(PostTransactionMethod.Redirect);
    var apiDocument = ViewData["ApiDocument"] as AOB.BAL.DTOs.Projects.ProjectDocumentInfoDto;
    var maxFileSizeMb = Configuration.GetValue("FileStorage:MaxFileSizeMB", 10);
    var maxFileBytes = maxFileSizeMb * 1024L * 1024L;
}

<form asp-action="GatewayConfiguration" asp-route-id="@project.Id" method="post" enctype="multipart/form-data" class="doc rise project-flow-form project-flow-form--adaptive">
    <partial name="_ProjectDocHeader" />
    <div class="ctxwrap">
        <div class="note ctxnote">
            <span class="ni" aria-hidden="true">
                <svg class="i sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
            </span>
            <div>
                <div class="nt">Card data stays out of your systems</div>
                <div class="nd">PCI Pal captures the card details and returns only the fields you choose here.</div>
            </div>
        </div>
        <div class="note you">
            <span class="ni" aria-hidden="true">
                <svg class="i sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </span>
            <div>
                <div class="nt">Never enter credentials or keys here</div>
                <div class="nd">PCI Pal collects them securely during setup.</div>
            </div>
        </div>
    </div>
    <div class="doc-paper project-flow-primary">
        <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>

        <section class="flow-section flow-section--first qrow adaptive-integration">
            <h5 class="flow-section-title qt">Integration fields — @gateway.GatewayName</h5>
            <p class="flow-section-hint qd">Required fields are always included. Tick the optional ones you want.</p>
            <div class="qctl">
                <div class="gateway-field-lists">
                    <partial name="_GatewayIntegrationFields" model="@(gateway, Model, authentication, inputs, outputs)" />
                </div>
            </div>
        </section>

        <section class="flow-section qrow">
            <h5 class="flow-section-title req qt">How should payment results come back?</h5>
            <p class="flow-section-hint qd">Choose all the methods your system will use.</p>
            <div class="qctl">
                @Html.EnumMultiSelect("PostTransactionMethods", postTransactionLabels, postTransactionSelected, placeholder: "Select how data is returned")
            </div>
        </section>

        <section id="redirectBox" class="flow-section qrow @(usesRedirect ? "" : "is-hidden")">
            <h5 class="flow-section-title req qt">Redirect URL</h5>
            <p class="flow-section-hint qd">Customers land here after paying. Must start with https://.</p>
            <span class="why" aria-hidden="true">Because you chose Redirect</span>
            <div class="qctl">
                <input asp-for="RedirectUrl" class="form-control" type="url" placeholder="https://www.example.com/payment-complete" />
                <span asp-validation-for="RedirectUrl" class="text-danger"></span>
            </div>
        </section>

        <section id="apiDocs" class="flow-section qrow @(usesCallback ? "" : "is-hidden")">
            <h5 class="flow-section-title qt">API documentation</h5>
            <p class="flow-section-hint qd">Upload the API documentation for your Web Callback endpoint (PDF, JSON, YAML, Word or text file).</p>
            <div class="qctl">
                @if (apiDocument is not null)
                {
                    <div class="xsmall muted" style="margin-bottom:8px">
                        Current file:
                        <a asp-action="DownloadApiDocumentation" asp-route-id="@project.Id">@apiDocument.FileName</a>
                        (@((apiDocument.FileSizeBytes / 1024.0).ToString("0.#")) KB, uploaded @apiDocument.UploadedAt.ToString("d MMM yyyy")).
                        Choose a new file below to replace it.
                    </div>
                }
                @* A browser never pre-fills a file input, so the saved document's name is shown in the drop area instead
                   of the native "No file chosen" (which read as if the upload had been lost). *@
                @{
                    var savedLabel = apiDocument is not null ? $"{apiDocument.FileName} · saved" : "Drop a file here, or choose one";
                }
                <label class="drop @(apiDocument is not null ? "has-file" : "")" data-drop data-saved-label="@savedLabel" data-saved="@(apiDocument is not null ? "true" : "false")">
                    <input type="file" name="apiDocumentation" id="apiDocumentation"
                           accept=".pdf,.json,.yaml,.yml,.doc,.docx,.txt"
                           data-max-bytes="@maxFileBytes" data-size-error="apiDocumentationSizeError"
                           aria-describedby="apiDocumentationHint" />
                    <span class="drop-ic" aria-hidden="true">
                        <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" /></svg>
                    </span>
                    <span style="flex:1" data-drop-label>@savedLabel</span>
                    <span class="btn btn-sm btn-quiet" aria-hidden="true">@(apiDocument is not null ? "Replace file" : "Choose file")</span>
                </label>
                <div class="xsmall muted" id="apiDocumentationHint" style="margin-top:6px">Maximum file size @(maxFileSizeMb) MB.</div>
                <span class="text-danger field-validation-error" id="apiDocumentationSizeError" role="alert" hidden></span>
                <span class="text-danger">@Html.ValidationMessage("ApiDocumentation")</span>
            </div>
        </section>

        @if (project.TakesPhonePayments)
        {
            <section class="flow-section qrow">
                <h5 class="flow-section-title req qt">Contact centre platform</h5>
                <p class="flow-section-hint qd">The platform your agents take calls on, and how it connects.</p>
                <span class="why" aria-hidden="true">Because customers pay on calls with an agent</span>
                <div class="qctl">
                    <div class="grid2">
                        <div>
                            <label asp-for="ContactCentrePlatform" class="form-label req"></label>
                            <select asp-for="ContactCentrePlatform" asp-items="Html.EnumSelectItems(ProjectOptions.ContactCentrePlatformLabels)" class="form-select">
                                <option value="">Select a platform</option>
                            </select>
                            <span asp-validation-for="ContactCentrePlatform" class="text-danger"></span>
                        </div>
                        <div>
                            <label asp-for="ConnectionType" class="form-label req"></label>
                            <select asp-for="ConnectionType" asp-items="Html.EnumSelectItems(ProjectOptions.ContactCentreConnectionTypeLabels)" class="form-select">
                                <option value="">Select a connection type</option>
                            </select>
                            <span asp-validation-for="ConnectionType" class="text-danger"></span>
                        </div>
                    </div>
                    <div>
                        <label asp-for="HandoverNotes" class="form-label">Call and payment handover notes <span class="opt">Optional</span></label>
                        <textarea asp-for="HandoverNotes" class="form-control" rows="3"
                                  placeholder="How calls and payment sessions pass between agents and PCI Pal."></textarea>
                        <span asp-validation-for="HandoverNotes" class="text-danger"></span>
                    </div>
                </div>
            </section>
        }

    </div>
    <partial name="_ProjectFlowActionBar" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function showWhenChecked(checkboxId, sectionId) {
            const checkbox = document.getElementById(checkboxId);
            const section = document.getElementById(sectionId);
            if (!checkbox || !section) return;
            function sync() { section.classList.toggle('is-hidden', !checkbox.checked); }
            checkbox.addEventListener('change', sync);
            sync();
        }
        showWhenChecked('PostTransactionMethods_Redirect', 'redirectBox');
        showWhenChecked('PostTransactionMethods_WebCallback', 'apiDocs');

        // Drop area: shows the saved document until a new file is chosen, then the new file's name.
        document.querySelectorAll('#apiDocs [data-drop]').forEach(function (zone) {
            var input = zone.querySelector('input[type="file"]');
            var label = zone.querySelector('[data-drop-label]');
            var saved = zone.getAttribute('data-saved') === 'true';
            function sync() {
                var chosen = input.files && input.files.length > 0;
                label.textContent = chosen ? input.files[0].name + ' · ready to upload' : zone.getAttribute('data-saved-label');
                zone.classList.toggle('has-file', chosen || saved);
            }
            input.addEventListener('change', sync);
            input.addEventListener('aob:file-cleared', sync);
            ['dragenter', 'dragover'].forEach(function (name) {
                zone.addEventListener(name, function () { zone.classList.add('is-over'); });
            });
            ['dragleave', 'drop'].forEach(function (name) {
                zone.addEventListener(name, function () { zone.classList.remove('is-over'); });
            });
        });
    </script>
}

