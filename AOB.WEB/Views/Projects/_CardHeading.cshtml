@{
    var title = ViewData["HeadingTitle"] as string ?? "";
    var icon = ViewData["HeadingIcon"] as string ?? "layers";
}

<h3 class="card-heading">
    <span class="card-heading-icon" aria-hidden="true">
        @switch (icon)
        {
            case "list":
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6h11M9 12h11M9 18h11M5 6h.01M5 12h.01M5 18h.01" /></svg>
                break;
            case "discovery":
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M16 16l4 4" /></svg>
                break;
            case "technical":
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="6" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" /></svg>
                break;
            case "payment":
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /></svg>
                break;
            case "adaptive":
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h10M4 18h14" /><circle cx="19" cy="12" r="2" /><circle cx="19" cy="18" r="2" /></svg>
                break;
            default:
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l9 5-9 5-9-5 9-5z" /><path d="M3 12.5l9 5 9-5" /></svg>
                break;
        }
    </span>
    @title
</h3>
