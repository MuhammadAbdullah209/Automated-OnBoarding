@model AOB.WEB.ViewModels.Health.HealthViewModel
@using AOB.WEB.ViewModels.Health
@{
    Layout = null;
    string Badge(HealthState s) => s switch { HealthState.Healthy => "ok", HealthState.Degraded => "warn", _ => "bad" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Health check</title>
    <style>
        body { font-family: Inter, system-ui, sans-serif; background: #f4f6fb; color: #1b2a6b; margin: 0; padding: 24px; }
        .wrap { max-width: 860px; margin: 0 auto; }
        h1 { font-size: 22px; margin: 0 0 4px; }
        .sub { color: #5b6585; font-size: 13px; margin-bottom: 20px; }
        .card { background: #fff; border-radius: 10px; padding: 18px 20px; margin-bottom: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .card h2 { font-size: 15px; margin: 0 0 12px; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        td, th { text-align: left; padding: 8px 6px; border-top: 1px solid #eceff6; vertical-align: top; }
        tr:first-child td, tr:first-child th { border-top: 0; }
        th { width: 220px; font-weight: 600; color: #5b6585; }
        code { font-family: "JetBrains Mono", Consolas, monospace; font-size: 12.5px; word-break: break-all; }
        .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; color: #fff; }
        .ok { background: #1f9d55; } .warn { background: #d98a00; } .bad { background: #d03a3a; }
        .big { font-size: 14px; padding: 4px 14px; }
    </style>
</head>
<body>
    <div class="wrap">
        <h1>Health check <span class="pill big @Badge(Model.Overall)">@Model.Overall</span></h1>
        <div class="sub">Checked @Model.CheckedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC &middot; your address @Model.CallerIp &middot; <a href="?format=json">JSON</a></div>

        <div class="card">
            <h2>Checks</h2>
            <table>
                @foreach (var check in Model.Checks)
                {
                    <tr>
                        <th>@check.Name</th>
                        <td><span class="pill @Badge(check.State)">@check.State</span> &nbsp;@check.Detail</td>
                    </tr>
                }
            </table>
        </div>

        <div class="card">
            <h2>Database</h2>
            <table>
                <tr><th>Type</th><td>@Model.DatabaseType</td></tr>
                <tr><th>EF Core provider</th><td><code>@Model.DatabaseProvider</code></td></tr>
                <tr><th>Database</th><td>@(string.IsNullOrEmpty(Model.DatabaseName) ? "-" : Model.DatabaseName)</td></tr>
                <tr><th>Server version</th><td>@(string.IsNullOrEmpty(Model.DatabaseServerVersion) ? "-" : Model.DatabaseServerVersion)</td></tr>
                <tr><th>Connection string</th><td><code>@Model.ConnectionString</code></td></tr>
            </table>
        </div>

        <div class="card">
            <h2>Application</h2>
            <table>
                <tr><th>Environment</th><td>@Model.Environment</td></tr>
                <tr><th>Version</th><td>@Model.AppVersion</td></tr>
                <tr><th>Runtime</th><td>@Model.Runtime</td></tr>
                <tr><th>Operating system</th><td>@Model.OperatingSystem</td></tr>
                <tr><th>Machine</th><td>@Model.MachineName</td></tr>
                <tr><th>Uptime</th><td>@($"{(int)Model.Uptime.TotalDays}d {Model.Uptime.Hours}h {Model.Uptime.Minutes}m")</td></tr>
                <tr><th>Memory in use</th><td>@Model.MemoryMb MB</td></tr>
            </table>
        </div>
    </div>
</body>
</html>
